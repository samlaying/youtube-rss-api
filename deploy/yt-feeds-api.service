[Unit]
Description=youtube-rss-api HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/yt-feeds
# Secrets live in /etc/default/yt-feeds-api (chmod 600), not in this world-readable
# unit file. Create it with:
#   YT_API_TOKEN=<long random string>
#   YT_FEEDS_PUBLIC_BASE=https://feeds.example.com/yt
EnvironmentFile=/etc/default/yt-feeds-api
ExecStart=/usr/bin/python3 /opt/yt-feeds/api.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
